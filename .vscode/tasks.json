{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Docker: Start MySQL",
            "type": "shell",
            "command": "docker-compose",
            "args": [
                "up",
                "-d"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            },
            "isBackground": true
        },
        {
            "label": "Docker: Stop MySQL",
            "type": "shell",
            "command": "docker-compose",
            "args": [
                "down"
            ],
            "problemMatcher": []
        },
        {
            "label": "Maven: Copy Dependencies (runtime)",
            "type": "shell",
            "command": "mvn",
            "args": [
                "dependency:copy-dependencies",
                "-DincludeScope=runtime"
            ],
            "problemMatcher": []
        },
        {
            "label": "Maven: Prepare Runtime",
            "type": "shell",
            "command": "mvn",
            "args": [
                "-DskipTests",
                "compile",
                "dependency:copy-dependencies",
                "-DincludeScope=runtime"
            ],
            "group": "build",
            "problemMatcher": "$javac",
            "dependsOn": [
                "Maven: Compile",
                "Maven: Copy Dependencies (runtime)"
            ]
        },
        {
            "label": "Maven: Clean",
            "type": "shell",
            "command": "mvn",
            "args": [
                "clean"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Maven: Compile",
            "type": "shell",
            "command": "mvn",
            "args": [
                "compile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$javac"
        },
        {
            "label": "Maven: Package",
            "type": "shell",
            "command": "mvn",
            "args": [
                "package"
            ],
            "group": "build",
            "problemMatcher": "$javac"
        },
        {
            "label": "Maven: Clean + Package",
            "type": "shell",
            "command": "mvn",
            "args": [
                "clean",
                "package"
            ],
            "group": "build",
            "problemMatcher": "$javac"
        },
        {
            "label": "Prepare + Seed Database",
            "dependsOn": [
                "Maven: Prepare Runtime",
                "Docker: Start + Wait",
                "Database: Seed (1M entries)"
            ],
            "problemMatcher": []
        },
        {
            "label": "Docker: Start + Wait",
            "type": "shell",
            "command": "docker-compose",
            "args": [
                "up",
                "-d"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "Run Standalone JAR",
            "type": "shell",
            "command": "java",
            "args": [
                "-jar",
                "${workspaceFolder}/target/videolibrary-swing-2.0.0-standalone.jar"
            ],
            "dependsOn": "Maven: Package",
            "problemMatcher": []
        }
    ]
}
