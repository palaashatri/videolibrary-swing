{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Maven: Clean",
            "type": "shell",
            "command": "mvn",
            "args": [
                "clean"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Maven: Compile",
            "type": "shell",
            "command": "mvn",
            "args": [
                "compile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$javac"
        },
        {
            "label": "Maven: Package",
            "type": "shell",
            "command": "mvn",
            "args": [
                "package"
            ],
            "group": "build",
            "problemMatcher": "$javac"
        },
        {
            "label": "Maven: Clean + Package",
            "type": "shell",
            "command": "mvn",
            "args": [
                "clean",
                "package"
            ],
            "group": "build",
            "problemMatcher": "$javac"
        },
        {
            "label": "Run Standalone JAR",
            "type": "shell",
            "command": "java",
            "args": [
                "-jar",
                "${workspaceFolder}/target/videolibrary-swing-2.0.0-standalone.jar"
            ],
            "dependsOn": "Maven: Package",
            "problemMatcher": []
        }
    ]
}
